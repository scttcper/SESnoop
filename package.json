{
  "name": "sesnoop",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/scttcper/sesnoop"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && pnpm run db:migrations:apply && wrangler deploy",
    "typecheck": "tsc --build",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:seed": "wrangler d1 execute sesnoop --local --file worker/db/seed.sql",
    "db:migrations:generate": "drizzle-kit generate",
    "db:migrations:apply": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.9",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/zod-adapter": "^1.167.0",
    "@tsndr/cloudflare-worker-jwt": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "hono": "^4.13.12",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "stoker": "^2.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@ctrl/oxlint-config": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.9.1"
}
